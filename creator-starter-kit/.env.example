# ─── Site ────────────────────────────────────────────────────────────────
# Public URL of the deployed site (no trailing slash). Used for SEO, Stripe redirects and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Business details (shown on /legal, clearly marked if missing) ───────
# Never invent these. Leave empty until you have real, registered details.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_LEGAL_FORM=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_COUNTRY=
NEXT_PUBLIC_BUSINESS_REGISTRATION=
NEXT_PUBLIC_BUSINESS_VAT=
NEXT_PUBLIC_BUSINESS_PUBLISHER=
NEXT_PUBLIC_BUSINESS_HOSTING=
NEXT_PUBLIC_SUPPORT_EMAIL=

# ─── Gumroad (optional: replaces the built-in Stripe checkout) ───────────
# Paste your Gumroad product URLs. When all three are set, buttons open Gumroad.
NEXT_PUBLIC_GUMROAD_STARTER_URL=
NEXT_PUBLIC_GUMROAD_PRO_URL=
NEXT_PUBLIC_GUMROAD_ULTIMATE_URL=

# ─── Payments (Stripe Checkout) ──────────────────────────────────────────
# ──────────────────────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional (tests / mock server only). Defaults to https://api.stripe.com
# STRIPE_API_BASE=

# ─── Digital delivery ────────────────────────────────────────────────────
# Long random string (>= 32 chars). Generate with: openssl rand -base64 48
DOWNLOAD_SIGNING_SECRET=
# Lifetime of one signed download URL, in seconds (default 900 = 15 min)
DOWNLOAD_URL_TTL_SECONDS=900
# How long a purchase access link stays valid after payment, in days (default 90)
ACCESS_LINK_MAX_AGE_DAYS=90

# ─── Contact form + order emails (Resend) ────────────────────────────────
RESEND_API_KEY=
# Must be an address on a domain verified in Resend
EMAIL_FROM=
# Where contact-form messages are delivered
CONTACT_TO_EMAIL=

{
  "name": "creator-starter-kit",
  "version": "1.0.0",
  "private": true,
  "description": "CREATOR STARTER KIT — premium digital product store (Next.js, TypeScript, Tailwind, Framer Motion)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "resources:build": "tsx scripts/build-resources.ts",
    "resources:check": "tsx scripts/check-resources.ts",
    "resources:zip": "tsx scripts/export-zips.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run resources:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "framer-motion": "^14.14.0",
    "geist": "^1.9.2",
    "lucide-react": "^1.79.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "marked": "^18.3.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
